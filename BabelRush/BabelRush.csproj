<Project Sdk="Godot.NET.Sdk/4.4.1">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net8.0</TargetFramework>
        <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'ios' ">net8.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2024.3.0"/>
        <PackageReference Include="KirisameLib.Asynchronous" Version="0.1.2" />
        <PackageReference Include="NLua" Version="1.7.4"/>
        <PackageReference Include="Tomlyn" Version="0.17.0"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="KirisameLib.Core" Version="0.1.8"/>
        <PackageReference Include="KirisameLib.Data" Version="0.2.6"/>
        <PackageReference Include="KirisameLib.Event" Version="0.3.1" />
        <PackageReference Include="KirisameLib.Godot" Version="0.1.2"/>
        <PackageReference Include="KirisameLib.Logging" Version="0.1.1"/>
    </ItemGroup>

    <ItemGroup>
        <!--        <ProjectReference Include="..\BabelRush.Generator\BabelRush.Generator.csproj"-->
        <!--                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" ExcludeAssets="runtime"/>-->
        <Analyzer Include="..\BabelRush.Generator\bin\$(Configuration)\netstandard2.0\merged\*.dll"/>
    </ItemGroup>

    <ItemGroup Condition=" '$(Configuration)' != 'DEBUG' ">
        <Compile Remove="Tests\**"/>
        <Compile Update="Scenery\Stages\StageNodeModel.cs">
            <DependentUpon>StageNode.cs</DependentUpon>
        </Compile>
        <Compile Update="Scenery\Rooms\RoomTemplateModel.cs">
            <DependentUpon>RoomTemplate.cs</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup Condition=" '$(Configuration)' != 'DEBUG' ">
        <EmbeddedResource Remove="Tests\**"/>
        <Compile Remove="Tests\**"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="**\*.tscn"/>
        <None Include="**\*.gd"/>
        <None Include="**\*.lua"/>
    </ItemGroup>

</Project>